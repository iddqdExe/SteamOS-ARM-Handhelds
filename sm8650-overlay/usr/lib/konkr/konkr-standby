#!/usr/bin/env python3
"""konkr-standby — software standby, shared with RP6 / SM8550.

Kernel suspend (s2idle and deep) does not reliably resume on the 7.1.2 kernel:
the device looked powered off and needed a forced restart. Steam's Sleep goes
through logind → systemd-suspend.service, which the port overrides to run
this instead. It:

  - pauses the running game (SIGSTOP on the Steam-launched process tree),
  - suspends audio, detaches the touch panel, unloads Wi-Fi and has
    gamescope power the panel off (konkr-sleep standby-pre),
  - freezes the user session (Steam, gamescope, games, Android), so nothing
    in userspace wakes the CPUs. PipeWire, WirePlumber and D-Bus keep
    running (idle, outputs suspended): frozen along with the apps, PipeWire
    woke hours out of date and audio lagged and crackled for minutes,
  - turns the panel backlight and the LEDs off,
  - drops CPU policy clocks to their minimum; SM8550 skips CPU hotplug and
    GPU clamping to preserve its existing resume workaround,
  - blocks until the power button is pressed again (or SIGUSR1; for testing
    over SSH run it with KONKR_STANDBY_KEEP_WIFI=1), then restores it all: CPUs and audio first,
    then the apps, then the screen.

Steam sees a normal suspend/resume cycle (PrepareForSleep false → true →
false). Nothing enters kernel suspend. This does not prove reliable wake-up
or low battery drain on RP6; those require hardware measurements.
"""
from __future__ import annotations

import glob
import os
import pwd
import select
import signal
import struct
import sys
import time

FLAG = "/run/konkr-standby"
EV = struct.Struct("llHHi")
EV_KEY, KEY_POWER = 1, 116


def rd(p: str, d: str = "") -> str:
    try:
        with open(p, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return d


def wr(p: str, v) -> bool:
    ok = wr_ok(p, v)
    if not ok:
        log(f"ERROR: cannot write {p}={v}")
    return ok


def wr_ok(p: str, v) -> bool:
    try:
        with open(p, "w", encoding="utf-8") as fh:
            fh.write(str(v))
        return True
    except OSError:
        return False


class StandbyError(Exception):
    """A transition failed; restore every operation already attempted."""


def save_write(saved: dict[str, str], path: str, value) -> None:
    previous = rd(path)
    if not previous or str(value) == "":
        raise StandbyError(f"cannot snapshot or determine target for {path}")
    # Save before writing: a failed write may still have changed the device.
    saved[path] = previous
    if not wr(path, value):
        raise StandbyError(f"cannot apply standby setting for {path}")


def run(*cmd: str) -> int:
    import subprocess
    process = None
    try:
        # The helper and its foreground children share a private group.
        # konkr-sleep uses timeout --foreground to preserve this boundary.
        process = subprocess.Popen(cmd, start_new_session=True,
                                   stdout=subprocess.DEVNULL)
        return process.wait(timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return 1
    finally:
        if process is not None:
            # Killing only the shell lets pactl/modprobe finish AFTER restore.
            # Also clean up descendants if the helper exited first.
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()


def big_cpus() -> list[int]:
    """CPUs above the lowest capacity (the A520s stay online)."""
    caps = {}
    for c in glob.glob("/sys/devices/system/cpu/cpu[0-9]*"):
        n = int(os.path.basename(c)[3:])
        v = rd(f"{c}/cpu_capacity", "0")
        caps[n] = int(v) if v.isdigit() else 0
    if not caps:
        return []
    low = min(caps.values())
    big = sorted(n for n, v in caps.items() if v > low and n != 0)
    # SM8550 (Adreno 740): the GMU can wedge when its interrupt wakes CPU 0-2,
    # so konkrd pins the GPU/GMU IRQs to the big cores. Offlining all of them
    # would push those IRQs back onto the little cores and hang the device
    # in standby (RP6, beta 4). Keep the first big core online there, whatever
    # the cmdline's irqaffinity says (the 7.0.14 kernel boots without one).
    irq = irq_cpus()
    if big and (is_sm8550() or (irq and not (irq - set(big)))):
        big.remove(min(big) if is_sm8550() else min(irq))
    return big


def is_sm8550() -> bool:
    try:
        with open("/sys/firmware/devicetree/base/compatible", "rb") as f:
            return b"qcom,sm8550" in f.read()
    except OSError:
        return False


def irq_cpus() -> set[int]:
    try:
        mask = int(rd("/proc/irq/default_smp_affinity", "0").replace(",", ""), 16)
    except ValueError:
        return set()
    return {n for n in range(64) if mask >> n & 1}


def log(msg: str) -> None:
    print(f"konkr-standby: {msg}", flush=True)


def game_pids() -> list[int]:
    children: dict[int, list[int]] = {}
    roots = []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/stat", "rb") as fh:
                st = fh.read()
            ppid = int(st[st.rfind(b")") + 2:].split()[1])
            with open(f"/proc/{p}/cmdline", "rb") as fh:
                cmd = fh.read()
        except (OSError, ValueError, IndexError):
            continue
        children.setdefault(ppid, []).append(int(p))
        if b"reaper\0SteamLaunch\0" in cmd:
            roots.append(int(p))
    out, stack = [], list(roots)
    while stack:
        pid = stack.pop()
        for c in children.get(pid, ()):
            out.append(c)
            stack.append(c)
    return out


def power_key_fd() -> int | None:
    for e in glob.glob("/sys/class/input/event*"):
        if rd(f"{e}/device/name") == "pmic_pwrkey":
            return os.open(f"/dev/input/{os.path.basename(e)}", os.O_RDONLY)
    return None


def backlight_targets() -> list[str]:
    devices = sorted(glob.glob('/sys/class/backlight/*'))
    if rd('/sys/firmware/devicetree/base/model').rstrip('\0') != 'Retroid Pocket 6':
        return devices
    # RP6 exports both its real PWM backlight and the panel driver's DSI
    # brightness endpoint. Gamescope uses PWM; the standby write to the DSI
    # endpoint failed on the second wake. Leave that endpoint to DRM.
    pwm = [path for path in devices if 'pwm-backlight' in
           rd(f'{path}/device/of_node/compatible').split('\0')]
    if len(pwm) != 1:
        raise StandbyError('RP6 requires exactly one PWM backlight; refusing standby')
    return pwm


# Keep audio and D-Bus running while freezing the graphical user.
KEEP_RUNNING = {"pipewire.service", "pipewire-pulse.service", "wireplumber.service",
                "dbus-broker.service", "at-spi-dbus-bus.service", "init.scope"}


def freeze_targets() -> list[str]:
    """cgroups to freeze: each session scope, every user-manager slice but
    session.slice, and every session.slice unit but KEEP_RUNNING."""
    out = []
    try:
        uid = pwd.getpwnam("steamos").pw_uid
        own = next(line.split(":", 2)[2].strip() for line in
                   open("/proc/self/cgroup") if line.startswith("0::"))
    except (KeyError, OSError, StopIteration):
        return []
    own = os.path.normpath("/sys/fs/cgroup" + own)
    for user in glob.glob(f"/sys/fs/cgroup/user.slice/user-{uid}.slice"):
        for child in sorted(os.listdir(user)):
            path = os.path.join(user, child)
            if not os.path.isdir(path):
                continue
            if not (child.startswith("user@") and child.endswith(".service")):
                out.append(path)                  # session-N.scope
                continue
            for sub in sorted(os.listdir(path)):
                spath = os.path.join(path, sub)
                if not os.path.isdir(spath) or sub in KEEP_RUNNING:
                    continue
                if sub != "session.slice":
                    out.append(spath)             # app.slice, …
                    continue
                for unit in sorted(os.listdir(spath)):
                    upath = os.path.join(spath, unit)
                    if os.path.isdir(upath) and unit not in KEEP_RUNNING:
                        out.append(upath)
    # A caller inside a graphical session must never freeze itself or the
    # session coordinating its wake-up. Root SSH sessions are not selected.
    return [path for path in out
            if own != path and not own.startswith(path + "/")]


def set_frozen(cgroups: list[str], frozen: bool) -> list[str]:
    """Write cgroup.freeze; returns the cgroups that took it."""
    done = [cg for cg in cgroups if wr(f"{cg}/cgroup.freeze", 1 if frozen else 0)]
    if frozen:
        end = time.monotonic() + 2.0              # let tasks reach the freezer
        while time.monotonic() < end and any(
                "frozen 1" not in rd(f"{cg}/cgroup.events") for cg in done):
            time.sleep(0.05)
    return done


WAKE_R, WAKE_W = os.pipe()


def wait_power_press(fd: int) -> None:
    """Block until a full press+release of the power key, or SIGUSR1."""
    pressed = False
    while True:
        r, _, _ = select.select([fd, WAKE_R], [], [])
        if WAKE_R in r:
            log("wake requested (SIGUSR1)")
            return
        data = os.read(fd, EV.size * 64)
        if not data:
            raise OSError("power key device disconnected")
        for off in range(0, len(data) - EV.size + 1, EV.size):
            _s, _u, t, code, val = EV.unpack_from(data, off)
            if t == EV_KEY and code == KEY_POWER:
                if val == 1:
                    pressed = True
                elif val == 0 and pressed:
                    log("wake: power key")
                    return


def main() -> int:
    fd = power_key_fd()
    if fd is None:
        log("no power key device; not entering standby")
        return 1
    saved: dict[str, str] = {}
    paused: list[int] = []
    offlined: list[int] = []
    frozen: list[str] = []
    status = 0
    prepared = False
    handlers = {}
    termination = None

    def interrupted(signum, _frame):
        nonlocal status, termination
        # Defer interruption across subprocess creation: raising between
        # spawning a helper and recording its PID would lose its cleanup.
        status, termination = 1, signum
        os.write(WAKE_W, b"x")

    def check_termination():
        if termination is not None:
            raise StandbyError(f"interrupted by signal {termination}")

    try:
        for sig, handler in ((signal.SIGUSR1, lambda *_: os.write(WAKE_W, b"x")),
                             (signal.SIGTERM, interrupted), (signal.SIGINT, interrupted)):
            handlers[sig] = signal.signal(sig, handler)
        open(FLAG, "w").close()
        # Drain the press that triggered sleep, so its release is not the wake.
        time.sleep(0.6)
        os.set_blocking(fd, False)
        try:
            while os.read(fd, EV.size * 64):
                pass
        except BlockingIOError:
            pass
        os.set_blocking(fd, True)
        check_termination()

        for pid in game_pids():
            try:
                # Track before sending: SIGTERM may arrive immediately after
                # SIGSTOP, before the next Python statement runs.
                paused.append(pid)
                os.kill(pid, signal.SIGSTOP)
            except OSError:
                pass
        for bl in backlight_targets():
            save_write(saved, f"{bl}/brightness", 0)
        for led in glob.glob("/sys/class/leds/*"):
            if "joystick" in led or "power-led" in led:
                save_write(saved, f"{led}/brightness", 0)
        prepared = True  # A failing helper may have partially prepared devices.
        if run("/usr/lib/konkr/konkr-sleep", "standby-pre") != 0:
            raise StandbyError("standby-pre failed")
        check_termination()
        time.sleep(0.3)               # let gamescope commit the panel-off
        frozen = freeze_targets()  # Thaw every attempted cgroup, even on failure.
        accepted = set_frozen(frozen, True)
        if len(accepted) != len(frozen) or any(
                "frozen 1" not in rd(f"{cg}/cgroup.events") for cg in frozen):
            raise StandbyError("session freeze failed or timed out")
        for pol in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
            # konkrd's touch boost may still hold the floor up (it drops it
            # within 0.5 s of this flag); a max below the min would be refused.
            floor = rd(f"{pol}/cpuinfo_min_freq")
            save_write(saved, f"{pol}/scaling_min_freq", floor)
            save_write(saved, f"{pol}/scaling_max_freq", floor)
        # SM8550: no CPU hotplug and no GPU clamp. Even with one big core kept
        # online the RP6 still never woke up from standby (only a 10 s hold
        # got it back, beta 7); the Adreno 740's GMU is the fragile part.
        # Frozen apps + screen off + CPU clocks at minimum are enough there.
        sm8550 = is_sm8550()
        for cpu in ([] if sm8550 else big_cpus()):
            offlined.append(cpu)  # Restore even if the attempted write fails.
            if not wr(f"/sys/devices/system/cpu/cpu{cpu}/online", 0):
                raise StandbyError(f"cannot offline CPU {cpu}")
        for gpu in ([] if sm8550 else glob.glob("/sys/class/devfreq/*gpu*")):
            freqs = sorted(int(f) for f in rd(f"{gpu}/available_frequencies").split() if f.isdigit())
            if freqs:
                save_write(saved, f"{gpu}/max_freq", freqs[0])
        how = (f"{len(frozen)} session cgroups frozen (audio kept running)" if frozen
               else "session NOT frozen")
        log(f"standby: paused {len(paused)} game processes, {how}, "
            f"cpus {offlined} offline, screen off")
        check_termination()
        wait_power_press(fd)
        log("wake")
    except (StandbyError, OSError) as exc:
        log(f"ERROR: {exc}; restoring")
        status = 1
    finally:
        # Ignore repeat termination requests during recovery; restore the
        # caller's handlers only after all cleanup has been attempted.
        for sig in (signal.SIGTERM, signal.SIGINT):
            if sig in handlers:
                signal.signal(sig, signal.SIG_IGN)
        # CPUs and clocks first, then audio, apps and the screen. Restore
        # maximums before minimums so cpufreq never sees min > standby max.
        for cpu in offlined:
            if not wr(f"/sys/devices/system/cpu/cpu{cpu}/online", 1):
                status = 1
        for path, val in sorted(saved.items(), key=lambda item: item[0].endswith("/scaling_min_freq")):
            if "/cpufreq/" in path or "/devfreq/" in path:
                if not wr(path, val):
                    status = 1
        if prepared and run("/usr/lib/konkr/konkr-sleep", "standby-audio-on") != 0:
            log("ERROR: standby-audio-on failed")
            status = 1
        if frozen and len(set_frozen(frozen, False)) != len(frozen):
            log("ERROR: session thaw failed")
            status = 1
        if prepared and run("/usr/lib/konkr/konkr-sleep", "standby-screen-on") != 0:
            log("ERROR: standby-screen-on failed")
            status = 1
        for path, val in saved.items():
            if "/cpufreq/" not in path and "/devfreq/" not in path:
                if not wr(path, val):
                    status = 1
        if prepared and run("/usr/lib/konkr/konkr-sleep", "standby-post") != 0:
            log("ERROR: standby-post failed")
            status = 1
        for pid in paused:
            try:
                os.kill(pid, signal.SIGCONT)
            except ProcessLookupError:
                pass  # A game may have exited during standby.
            except OSError as exc:
                log(f"ERROR: cannot resume game process {pid}: {exc}")
                status = 1
        time.sleep(0.5)               # let the wake release settle before konkrd sees keys
        try:
            os.remove(FLAG)
        except FileNotFoundError:
            pass
        except OSError as exc:
            log(f"ERROR: cannot clear standby flag: {exc}")
            status = 1
        os.close(fd)
        # konkrd re-applies profile clocks/LEDs on SIGHUP.
        if run("systemctl", "kill", "-s", "HUP", "konkrd.service") != 0:
            log("ERROR: profile reapply request failed")
            status = 1
        for sig, handler in handlers.items():
            signal.signal(sig, handler)
        log("restore: complete" if status == 0 else "restore: completed with errors (see journal)")
    return status


if __name__ == "__main__":
    sys.exit(main())
