#!/bin/sh
# RP6: accepted standby by default; UP-04 kernel s2idle remains opt-in.
if [ ! -e /var/lib/konkrd/sleep-standby ] && { [ -e /var/lib/konkrd/sleep-s2idle ] || [ -e /run/konkr/s2idle ]; }; then
  if [ ! -f /run/konkr/sleep-ready ] || [ ! -f /run/konkr/sleep-state.json ]; then
    echo 'konkr-suspend: preparation failed or recovery pending; refusing s2idle' >&2
    exit 1
  fi
  exec /usr/lib/systemd/systemd-sleep suspend
fi
exec /usr/lib/konkr/konkr-standby
