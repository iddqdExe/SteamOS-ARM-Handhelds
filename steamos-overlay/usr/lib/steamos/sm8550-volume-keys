#!/usr/bin/env python3
"""SM8550 volume rocker: native keys and InputPlumber volume signals → pactl.

RP6 Volume Up shares gpio-keys with the paddles, so InputPlumber owns it.
Do not grab USB/Bluetooth keyboards, mice, or the gamepad.
"""
from __future__ import annotations

import array
import fcntl
import glob
import os
import re
import select
import struct
import subprocess
import sys

EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_KEY = 0x01
KEY_MUTE = 113
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
STEP = os.environ.get("SM8550_VOLUME_STEP", "5%")
LIMIT = os.environ.get("SM8550_VOLUME_LIMIT", "1.0")
ALLOW = ("gpio-keys", "pmic_resin")
DBUS_VOLUME = re.compile(
    r"^/org/shadowblip/InputPlumber/devices/target/dbus\d+: "
    r"org\.shadowblip\.Input\.DBusDevice\.InputEvent "
    r"\('(?P<event>ui_volume_up|ui_volume_down|ui_volume_mute)', (?P<value>[-+\d.eE]+)\)$"
)


def log(msg: str) -> None:
    print(f"sm8550-volume-keys: {msg}", flush=True)


def wpctl(*args: str) -> None:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        subprocess.run(
            ["wpctl", *args],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            env=env,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass


def device_name(path: str) -> str:
    name = os.path.basename(path)
    sysname = f"/sys/class/input/{name}/device/name"
    try:
        return open(sysname, encoding="utf-8", errors="ignore").read().strip()
    except OSError:
        return ""


def has_volume_keys(fd: int) -> bool:
    buf = array.array("B", [0] * 96)
    nr = 0x20 + EV_KEY
    ioc = (2 << 30) | (ord("E") << 8) | nr | (len(buf) << 16)
    try:
        fcntl.ioctl(fd, ioc, buf, True)
    except OSError:
        return False

    def bit(code: int) -> bool:
        return bool(buf[code // 8] & (1 << (code % 8)))

    return bit(KEY_VOLUMEUP) or bit(KEY_VOLUMEDOWN) or bit(KEY_MUTE)


def open_devices() -> list[tuple[str, int]]:
    opened: list[tuple[str, int]] = []
    for path in sorted(glob.glob("/dev/input/event*")):
        dname = device_name(path).lower()
        if not any(a in dname for a in ALLOW):
            continue
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        if not has_volume_keys(fd):
            os.close(fd)
            continue
        log(f"watch {path} ({dname})")
        opened.append((path, fd))
    return opened


def pactl(*args: str) -> str:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        return subprocess.run(["pactl", *args], check=False, capture_output=True,
                              text=True, timeout=2, env=env).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""


def apply(code: int) -> None:
    # Step in the same (PulseAudio/cubic) scale as Steam's volume bar. wpctl
    # steps in a different scale: from ~20 % on the bar one "5 %-" step hit
    # zero and muted the sink.
    if code == KEY_VOLUMEUP:
        pactl("set-sink-mute", "@DEFAULT_SINK@", "0")
        cur = pactl("get-sink-volume", "@DEFAULT_SINK@")
        pct = int(cur.split("/")[1].strip().rstrip("%")) if "/" in cur else 0
        limit = int(float(LIMIT) * 100)
        pactl("set-sink-volume", "@DEFAULT_SINK@", f"{min(limit, pct + int(STEP.rstrip('%')))}%")
    elif code == KEY_VOLUMEDOWN:
        pactl("set-sink-volume", "@DEFAULT_SINK@", f"-{STEP}")
    elif code == KEY_MUTE:
        pactl("set-sink-mute", "@DEFAULT_SINK@", "toggle")


def dbus_volume_code(line: str) -> int | None:
    """Only a volume press from an InputPlumber DBus target changes audio."""
    match = DBUS_VOLUME.fullmatch(line.strip())
    if match is None:
        return None
    try:
        if float(match['value']) != 1.0:
            return None
    except ValueError:
        return None
    return {'ui_volume_up': KEY_VOLUMEUP, 'ui_volume_down': KEY_VOLUMEDOWN,
            'ui_volume_mute': KEY_MUTE}[match['event']]


def main() -> int:
    devs = open_devices()
    fds = {fd: path for path, fd in devs}
    # gdbus subscribes to public signals as the session user (busctl monitor
    # would require root). It follows the well-known name across IP restarts.
    # The DBus route also works when Steam removes the keyboard target.
    try:
        monitor = subprocess.Popen(
            ['gdbus', 'monitor', '--system', '--dest', 'org.shadowblip.InputPlumber'],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            env={**os.environ, 'LC_ALL': 'C'},
        )
    except FileNotFoundError:
        log('gdbus is required for InputPlumber volume keys')
        for fd in fds:
            os.close(fd)
        return 1
    assert monitor.stdout is not None
    dbus_fd = monitor.stdout.fileno()
    pending = b''
    log('watch InputPlumber DBus volume signals')
    try:
        while True:
            try:
                ready, _, _ = select.select([*fds, dbus_fd], [], [], 2.0)
            except InterruptedError:
                continue
            for fd in ready:
                if fd == dbus_fd:
                    data = os.read(fd, 4096)
                    if not data:
                        log('InputPlumber signal monitor stopped; restarting service')
                        return 1
                    lines = (pending + data).split(b'\n')
                    pending = lines.pop()
                    for line in lines:
                        code = dbus_volume_code(line.decode('utf-8', errors='replace'))
                        if code is not None:
                            apply(code)
                    continue
                try:
                    data = os.read(fd, EVENT_SIZE * 8)
                except OSError:
                    continue
                for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                    _s, _us, etype, code, value = struct.unpack_from(EVENT_FMT, data, off)
                    if etype == EV_KEY and value == 1:
                        apply(code)
    finally:
        for fd in fds:
            os.close(fd)
        monitor.terminate()
        try:
            monitor.wait(timeout=2)
        except subprocess.TimeoutExpired:
            monitor.kill()
            monitor.wait()
        monitor.stdout.close()


if __name__ == "__main__":
    sys.exit(main())
